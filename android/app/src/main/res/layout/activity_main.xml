<?xml version="1.0" encoding="utf-8"?>
<!--
  设备端点页。刻意做得像一张「仪表盘」而不是聊天界面：
  路线 B 下手机不负责输入任务（任务在 Shadow Core 侧下发），
  这一页要回答的是三个问题——权限齐了吗、端点在跑吗、Core 该填什么地址。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!--
          一站式结论（v4.2 §三 P1 的 SetupWizard）：把「能不能用了」压成一行。
          下面那些逐项状态是给排查用的，演示现场需要的是抬头就能读出结论——
          「还不能工作：缺 辅助功能服务、屏幕捕获」比两行「未开启」有用得多。
        -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_readiness"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/readiness_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#33FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/section_permissions"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/accessibility_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_accessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_open_accessibility" />

        <TextView
            android:id="@+id/projection_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_projection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_request_projection" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#33FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/section_endpoint"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/endpoint_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/endpoint_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textIsSelectable="true"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_toggle_endpoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/action_start_endpoint" />

        <TextView
            android:id="@+id/endpoint_usage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_copy_usage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_copy" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/warn_lan_exposure"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
